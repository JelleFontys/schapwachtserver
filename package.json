{
  "engines": {
    "node": "24"
  },
  "name": "schapwachtserver",
  "version": "1.0.0",
  "description": "API van SchapWacht",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
